---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featured = allProjects
  .filter(p => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Kunal Janghel — Staff Software Engineer · AI Agents + AppSec">
  <Hero />

  <section class="max-w-gallery mx-auto px-6 py-16">
    <SectionHeader title="featured work" href="/projects" hrefLabel="all projects" />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map(p => (
        <ProjectCard
          slug={p.id}
          title={p.data.title}
          subtitle={p.data.subtitle}
          tags={p.data.tags}
          liveUrl={p.data.liveUrl}
        />
      ))}
    </div>
  </section>

  <section class="max-w-reading mx-auto px-6 py-16">
    <SectionHeader title="about" href="/about" hrefLabel="full story" />
    <p class="text-lg leading-relaxed">
      Born in Jamshedpur, based in Bengaluru. I got my start at Infosys, joined Barracuda in 2019, and grew from
      shipping WAF features to leading AI+security initiatives. I like problems where the answer is a small
      amount of code that unlocks a large amount of leverage — like the multi-tenant redesign that cut our VM
      spend by 60%, or the RAG pipeline that turned a 20k-line OpenAPI spec into something Claude can talk to.
    </p>
  </section>

  <section class="max-w-reading mx-auto px-6 py-16">
    <SectionHeader title="contact" />
    <div class="flex flex-wrap gap-6 font-mono text-sm">
      <a href="mailto:hello@janghel.com" class="inline-flex items-center gap-2 hover:text-accent transition-colors">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        hello@janghel.com
      </a>
      <a href="https://github.com/kjanghel" class="inline-flex items-center gap-2 hover:text-accent transition-colors">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.605-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12"/>
        </svg>
        github.com/kjanghel
      </a>
      <a href="https://www.linkedin.com/in/kunal-janghel/" class="inline-flex items-center gap-2 hover:text-accent transition-colors">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        linkedin.com/in/kunal-janghel
      </a>
    </div>
  </section>
</BaseLayout>
